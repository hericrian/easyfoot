{
  "name": "easyfoot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name easyfoot --branch main",
    "brand": "node brand/wordmark.mjs && node brand/pix.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/saira": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "opentype.js": "^1.3.4",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.164.0"
  }
}
